# The client's dev server, and this service's server (PORT on Cloud Run).
PORT=3400
NOTIFICATIONS_SERVER_PORT=3401

# Where the dev server sends /api and /design: a Ki.CL deployment by default.
# KICL_HOST_URL=https://dev.ki-cl.com
# KICL_BACKEND_URL=http://localhost:3100
# KICL_DESIGN_URL=http://localhost:3200
# The token for the Ki.CL deployment's proxy, if it is used.
# KICL_CLIENT_TOKEN=
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# The notifications collection. Locally, the same database as core.
MONGODB_ATLAS_URI=
MONGODB_DATABASE=dev

# The Pub/Sub topic this service publishes its demo steps to. Unset, a notice is applied directly.
# NOTIFICATIONS_TOPIC=notifications-dev
